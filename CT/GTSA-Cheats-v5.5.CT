  writeFloat(0x206E1F25, TPZ_Negative)
end

end

function CETrainer_CECheckbox19Change(sender)
  if sender.checked then
     be_negative=true
    --CETrainer.CELabel5.Font.Color = green
  else
      be_negative=false
    --CETrainer.CELabel5.Font.Color = red
  end
end

function CETrainer_CECheckbox20Change(sender)
  if sender.checked then
     writeByte(0x2066C814,1)
  else
      writeByte(0x2066C814,0)
  end
end

function CETrainer_CECheckbox21Change(sender)
  if sender.checked then
     writeByte(0x2066C81C,1)
  else
      writeByte(0x2066C81C,0)
  end
end

