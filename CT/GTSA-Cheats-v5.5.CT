function AboutClick()
  showMessage(gAboutText)
end
gAboutText=[[GTA SA: Cheats Companion App
 * to be used with ".pnach" et Modified "Main.scm"

App Instructions;-
  1. Toggle Cheats, with Hotkeys
  2. Vehicle ID
       Increase [+] or [GAMEPAD (R2)]
       Decrease [-] or [GAMEPAD (L2)]
  3. Teleport
       Set X,Y,Z coordinates using NUMPAD
       Check negative if needed, type value, assign an axis.
       In-Game -&gt; open teleport cheat menu (Select + L1)
       Select Option 7 "The Four Dragons Casino"
       Use .pnach to change option to a custom label.

Issues;-
  1. Vehicle ID, Spawn VH not updating.
  * Common emulator behaviour - Save et Load State to update changes.
  ...Or...
  * in Emulator -&gt; enable ".pnach" Cheats and execute these once;-
  * Execute: Press et hold R1 - to increment VH ID (+1)
  * Execute: R1+R2 (Enable VH Spawn),
  * Execute: Any buttons x 2 to spawn a VH,
  * Execute: L1+L2 (Disable VH Spawn).

  * You can now use the Cheat Menu buttons for that game session.
  And
  * Disable the R1(+1) patch in the pnach cheats, use the apps R2, L2 to +/-.

www.TKBS.uk]]

function CloseClick()
  --called by the close button onClick event, and when closing the form
if hooked == true then
  d3dhook_renderobject_setVisible(DisplayedTextObject2, false) -- show
  d3dhook_renderobject_setVisible(DisplayedTextObject, false) -- show
  -- Kill Timers
  --t1=nil
  --t2=nil
  --t1.Destroy()
  --t2.Destroy()
  -- Close
  closeCE()
  return caFree --onClick doesn't care, but onClose would like a result
else
  -- Kill Timers
  --t1=nil
  --t2=nil
  --t1.Destroy()
  --t2.Destroy()
  -- Close
  closeCE()
  return caFree --onClick doesn't care, but onClose would like a result
end
end

