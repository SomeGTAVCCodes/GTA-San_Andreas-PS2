function QuickSave(sender)
  writeBytes(0x206FFAAB,1)
end

function TimesCheated(sender)
  writeBytes(0x208023F4,0)
end

function Collectibles(sender)
  writeBytes(0x2080259C,50) --Oysters
  writeBytes(0x2080256C,50) --SNAPSHOTS
  writeBytes(0x20802594,50) --Horse-shoes
  writeBytes(0x2066C640,100) --Tags
  -- Disable after use
  sender.Enabled = false
end

--100% STATS unlock - Hydra + Rhino, and other bonues etc
--//20802260 447A0000
function completeunlock(sender)
  writeBytes(0x20802260, 0x00, 0x00, 0x7A, 0x44)
  -- Disable after use
  sender.Enabled = false
end

function MoonSize(sender)
moon=readSmallInteger(0x20666D4C)
moonvalueToAdd=1
if moon ~= 7 then
   writeSmallInteger(0x20666D4C, moon + moonvalueToAdd)
else
writeBytes(0x20666D4C, 0x00, 0x00, 0x00, 0x00)
end
end

-- This is Infinite Ammo using Replenish Clip,
-- as a result: no reload is required and rockets become fast firing.
function TOGGLE_FAST_RELOAD(sender)
--patch=1,EE,20134340,extended,24420001 // Chamber 	|| 2442FFFF --&gt; 24420001
--patch=1,EE,201343A4,extended,24420000 // CLIP		|| 2442FFFF --&gt; 24420000
  if sender.checked then
    writeBytes(0x20134340, 0x01, 0x00, 0x42, 0x24)
    writeBytes(0x201343A4, 0x00, 0x00, 0x42, 0x24)
  else
    writeBytes(0x20134340, 0xFF, 0xFF, 0x42, 0x24)
    writeBytes(0x201343A4, 0xFF, 0xFF, 0x42, 0x24)
  end

end

-----------------------------------------------
-- ---- AOB Scans, for dynamic addresses ----
-- ISSUE: Impossible to set a scan range ?
-- Issue: AoB[0] Why [0]? - dah fuq is that? an index, the byte to start write at ?
--issue: sahould only need a word, 90 write to 1 byte, but 10% of the time this fails ?
-- Issue: need to prevent patching wrong address
--... can happen if player patches correct address saves game, and reboots the game and app
--app will detect the 30000000 address versions.
--[[
if
AoB_Already_Patched_1 = AOBScan("D4 90 70 00")
AoB_Already_Patched_2 = AOBScan("D4 90 90 90")
AoB_CORRECT_unpatched_result = AOBScan("D4 96 70 00 02 B5 6C AF")
AoB_Incorrect_unpatched_result = AOBScan("D4 96 70 00 99 A3 30 9F")
--]]
-----------------------------------------------

function No_Fall_DMG(sender)
AoB = AOBScan("D4 96 70 00")
  if AoB then
    --print("Dynamic Address Found")
    writeBytes(AoB[0], 0xD4, 0x90, 0x90, 0x90)
    -- Disable after use
    sender.Enabled = false
  else
    -- Disable if fail
    sender.Enabled = false
  end
end


--[[
--FAST_RELOAD_ENABLED = false
function FAST_RELOAD()
-- Dynamic Address so we use Array of Bytes Scanning to find and replace.
AoB = AOBScan("00 00 64 64 66 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64")
  if AoB then
    writeBytes(AoB[0], 0x01)
  else
    print("Not Found")
    FAST_RELOAD_RESET()
  end
end

function FAST_RELOAD_RESET()
AoB2 = AOBScan("01 00 64 64 66 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64")
  if AoB2 then
    writeBytes(AoB[0], 0x00)
  else
    print("Not Found")
    FAST_RELOAD_RESET()
  end
end

function TOGGLE_FAST_RELOAD(sender)
AoB = AOBScan("00 00 64 64 66 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64")
AoB2 = AOBScan("01 00 64 64 66 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 64 32 64 64 64 64 64 64 64 64 64 64 64 64 64")
  if sender.checked then

    if AoB then
      writeBytes(AoB[0], 0x01)
      print("Found 1")
    elseif AoB2 then
      writeBytes(AoB2[0], 0x00)
      print("Found 0")
    else
    print("AOB Scans failed")
    end
  else
    if AoB then
      writeBytes(AoB[0], 0x01)
      print("Found 1")
    elseif AoB2 then
      writeBytes(AoB2[0], 0x00)
      print("Found 0")
    else
    print("AOB Scans failed")
    end
  end


end
--]]

-- -----------------------------------------
-- ---- Buttons: Spawn Vehicle (".pnach support") ----
-- ----------------------------------------

--[[
function ENABLE_VH_SPAWN(sender)
  writeBytes(0x2059D4A0, 0x18, 0x1B, 0x02, 0x3C) -- 3C021B18
  writeBytes(0x2059D4B4, 0x2B, 0x4F, 0x42, 0x34) -- 34424F2B
end

function DISABLE_VH_SPAWN(sender)
  writeBytes(0x2059D4B4, 0x00, 0x00, 0x00, 0x00) -- 00000000
  writeBytes(0x2059D4A0, 0x94, 0x58, 0x13, 0x0C) -- 0C135894
end
--]]

function TOGGLE_VH_SPAWN(sender)
if vhs == true then
    writeBytes(0x2059D4A0, 0x18, 0x1B, 0x02, 0x3C) -- 3C021B18
    writeBytes(0x2059D4B4, 0x2B, 0x4F, 0x42, 0x34) -- 34424F2B
    control_setCaption(CETrainer.CEButton21, "VHS Enabled")
    vhs=false
  else
    writeBytes(0x2059D4B4, 0x00, 0x00, 0x00, 0x00) -- 00000000
    writeBytes(0x2059D4A0, 0x94, 0x58, 0x13, 0x0C) -- 0C135894
    control_setCaption(CETrainer.CEButton21, "VHS Disabled")
    vhs=true
end
return vhs
end

-- -----------------------------------------
-- ---- Patch PAL 50, 60hz ----
-- -----------------------------------------
-- PAL 50hz
function PAL_50hz(sender)
  writeBytes(0x20547BC4, 0x01, 0x00, 0x02, 0x24)
  CETrainer.CELabel3.Font.Color = 0x00FF00 -- + 5000000 -- Green (B,G,R)
  CETrainer.CELabel4.Font.Color = 0x0000FF -- + 1100000 -- Red  (B,G,R)
end

-- PAL 60hz
function PAL_60hz(sender)
  writeBytes(0x20547BC4, 0x02, 0x00, 0x12, 0x24)
  CETrainer.CELabel4.Font.Color = 0x00FF00 -- + 5000000 -- Green  (B,G,R)
  CETrainer.CELabel3.Font.Color = 0x0000FF -- + 5500000 -- Red  (B,G,R)
end

-- PAL Emotion Engine 30 -&gt; 60+ || 24040002 -&gt; 24040001
function EENGINE_60()
local str = readByte(0x2039B62C) -- Example
  if str == 01 then
    writeBytes(0x2039B62C, 0x02, 0x00, 0x04, 0x24)
    CETrainer_CELabel9.Caption = "EE 30" -- red, green
    CETrainer_CELabel9.Font.Color = 0x0000FF
  end
  if str == 02 then
    writeBytes(0x2039B62C, 0x01, 0x00, 0x04, 0x24)
    CETrainer_CELabel9.Caption = "EE 60+" -- red, green
    CETrainer_CELabel9.Font.Color = 0x00FF00
  end
end

