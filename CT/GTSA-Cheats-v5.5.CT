control_setCaption(CETrainer_CEButton19, "Collectibles")
control_setCaption(CETrainer_CEButton20, "100% Bonuses")
control_setCaption(CETrainer_CEButton21, "Toggle VH Spawn")
control_setCaption(CETrainer_CEButton22, "Moon Size [0-7]")
control_setCaption(CETrainer_CEButton9, "TP-X")
control_setCaption(CETrainer_CEButton10, "TP-Y")
control_setCaption(CETrainer_CEButton23, "TP-Z")
control_setCaption(CETrainer_CEButton24, "No Fall DMG")
-- CheckBox Names et colours
CETrainer_CECheckbox19.Caption = "Set Negative"
CETrainer_CECheckbox19.Font.Color = 0x0000FF
-- CheckBox Names et colours
CETrainer_CECheckbox20.Caption = "Night Vision"
