        { keys = { "rccam", "RCCam", "594" }, value = 594 },
        { keys = { "launch", "Launch", "595" }, value = 595 },
        { keys = { "copcarla", "596" }, value = 596 },
        { keys = { "copcarsf", "597" }, value = 597 },
        { keys = { "copcarvg", "598" }, value = 598 },
        { keys = { "copcarru", "599" }, value = 599 },
        { keys = { "picador", "Picador", "600" }, value = 600 },
        { keys = { "swatvan", "SwatVan", "601" }, value = 601 },
        { keys = { "alpha", "Alpha", "602" }, value = 602 },
        { keys = { "phoenix", "Phoenix", "603" }, value = 603 },
        { keys = { "glenshit", "Glenshit", "604" }, value = 604 },
        { keys = { "sadlshit", "Sadlershit", "605" }, value = 605 },
        { keys = { "bagboxa", "606" }, value = 606 },
        { keys = { "bagboxb", "607" }, value = 607 },
        { keys = { "tugstair", "608" }, value = 608 },
        { keys = { "boxburg", "609" }, value = 609 },
        { keys = { "farmtr1", "610" }, value = 610 },
          -- Continue for all mappings,
        { keys = { "utiltr1", "611" }, value = 611 }
        }

    local text = CETrainer.CEEdit1.Text
    local VHID_CHOICE = nil

    for _, group in ipairs(mappings) do
        for _, key in ipairs(group.keys) do
            if text == key then
                VHID_CHOICE = group.value
                break
            end
        end
        if VHID_CHOICE then break end
    end

    if VHID_CHOICE then
        writeSmallInteger(0x2059ED14, VHID_CHOICE)
        -- Optional: reset or update your UI here if needed
        CETrainer.CEEdit1.Text = "_"
    end
end

-- -----------------------------------------
-- ---- Timers: VEHICLE ID GET ----
-- -----------------------------------------

-- timer get VH ID from +,-
t1=createTimer(nil)
timer_setInterval(t1,100) --check every 1/100th second if the value has changed
timer_onTimer(t1,GET_VHID)

-- timer get VH ID from users text entry
t2=createTimer(nil)
timer_setInterval(t2,100)
timer_onTimer(t2,VHID_FROM_TEXT_EDIT)

-- -----------------------------------------
-- ---- Hotkeys, Button Inputs: Functions. ----
-- -----------------------------------------

function onPostHotKey() -- Set Cars Invisible on press Numeric 0
if ((checkbox_getState(CETrainer.CECheckBox1)) == 0) then
      CETrainer.CELabel5.Font.Color = green -- 'Cheat Enabled...'
      checkbox_setState(CETrainer.CECheckBox1, 1) -- set checkbox Ticked
      writeByte(0x2088D81B,1)
elseif ((checkbox_getState(CETrainer.CECheckBox1)) == 1) then
      CETrainer.CELabel5.Font.Color = red -- 'Cheat Disabled...'
      checkbox_setState(CETrainer.CECheckBox1, 0) -- set checkbox Not Ticked
      writeByte(0x2088D81B,0)
else
print("fail")
end
end

function onPostHotKey2() -- Set Cars on Water on press Numeric 1
if ((checkbox_getState(CETrainer.CECheckBox2)) == 0) then
      CETrainer.CELabel6.Font.Color = green -- 'Cheat Enabled...'
      checkbox_setState(CETrainer.CECheckBox2, 1) -- set checkbox Ticked
      writeByte(0x2088D822,1)
elseif ((checkbox_getState(CETrainer.CECheckBox2)) == 1) then
      CETrainer.CELabel6.Font.Color = red -- 'Cheat Disabled...'
      checkbox_setState(CETrainer.CECheckBox2, 0) -- set checkbox Not Ticked
      writeByte(0x2088D822,0)
else
print("fail")
end
end

function onPostHotKey3() --- Set Cars fly on press Numeric 2
if ((checkbox_getState(CETrainer.CECheckBox4)) == 0) then
      CETrainer.CELabel7.Font.Color = green -- 'Cheat Enabled...'
      checkbox_setState(CETrainer.CECheckBox4, 1) -- set checkbox Ticked
