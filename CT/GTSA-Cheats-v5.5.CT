end

if be_negative==true then
   TPY_CHOICE=tonumber(CETrainer.CEEdit2.Text)
   TPY_Negative=TPY_CHOICE-TPY_CHOICE-TPY_CHOICE
  writeFloat(0x206E1F20, TPY_Negative)
end

end

