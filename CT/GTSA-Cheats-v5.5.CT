control_setCaption(CETrainer_CEButton14, "D3DHook")
control_setCaption(CETrainer_CEButton16, "INFO")
control_setCaption(CETrainer_CEButton17, "Quick Save")
control_setCaption(CETrainer_CEButton18, "Set # Times Cheated 0")
