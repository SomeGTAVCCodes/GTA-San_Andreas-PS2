  <UserdefinedSymbols/>
  <LuaScript>--[[
TITILE:     GTA:SAN_ANDREAS Cheats App (".exe")
Author:     TKBS
INFO:       A Companion App for ".pnach" cheats.
            + A basic template for creating cheat apps with CE.
ISSUE:
            Screen == PRIMARY Monitor, not the actual window we hooked
            ... which makes no sense coz we hook and anchor text to it.
            and that text font size is set based on primary monitor (1080p)
            so if we switch midgame to 4k, text is way too samll.

            CE checks and unchecks boxes randomly - be careful to spot this
            CE has no FORCE NO CODE option.
            i.e. to edit code, addresses, values, all at the same time without hotkeys activating is not possible.

            Timers may be an issue

            Performance is shit for some reason.

            ampersand symbols not supported ?

            cannot use dynamic addresses or pointers

  This is needed to make sure when app loads any incorrect vehicle IDs are set to a valid one.
  but it crashes ?
  if VHIDSHOW1 &gt; 611 then
  VHIDSHOW1 = 400
  end

  if VHIDSHOW1 &lt; 400 then
  VHIDSHOW1 = 400
  end

TODO:
            All cheats need to be changed to check the 'checkbox' states first.
            and values addresses first before setting cheats etc. I.E. Make it robust
            This is incredibly convoluted due to Emulator behaviour
            Some codes require pause-remue, or save reload to take effect
            IF we modify a dynamic address using AOB - we have no way of getting it back
            IF player saves after an AOB dynamic replacement we have no way of checking that after shutdown re-boot if the new val;ue happens to be NOT unique.

            make the region et version game switches + cheats
            et the vice city game switch.
            This was removed due to code inflation. it would be cool to have all games in one app, but it is faster to simply copy, paste this file than make it robust for game switching.
            for switch mode all code must be shutdown as default until game is detected.
]]
-- -----------------------------------------
-- ---- Setup CE ----
-- -----------------------------------------
--ReccommendedCEVersion=6.5 (7.6 is buggy as fuck.)
RequiredCEVersion=7.6
if (getCEVersion==nil) or (getCEVersion()&lt;RequiredCEVersion) then
  messageDialog('Please install Cheat Engine '..RequiredCEVersion, mtError, mbOK)
  closeCE()
end

addresslist=getAddressList()
--CETrainer.SEPERATOR.Visible=false (the line thing from the template menu form)
getAutoAttachList().add("pcsx2.exe")
gPlaySoundOnAction=false
CETrainer.fixDPI() --remove this if you have already taken care of DPI issues yourself
CETrainer.show()

-- -----------------------------------------
-- Define Colours as names (B,G,R)
-- -----------------------------------------
red="0x000000FF"
green="0x0000FF00"
black="0x00999999"
blue="0x00FF0000"
pink="0x0cc00FF"
green2="0x0099FF99"
pink2="0x00FF00FF"

-- -----------------------------------------
-- ---- Setup ----
-- -----------------------------------------
CETrainer_CELabel5.Caption = "Toggle Numeric 0" -- toggle red, green when checked
CETrainer_CELabel5.Font.Color = 0x0000FF
CETrainer_CELabel6.Caption = "Numeric 1"
CETrainer_CELabel6.Font.Color = 0x0000FF
CETrainer_CELabel7.Caption = "Numeric 2"
CETrainer_CELabel7.Font.Color = 0x0000FF
-- 8
CETrainer_CELabel8.Caption = "Numeric 3"
CETrainer_CELabel8.Font.Color = 0x0000FF
-- ...
CETrainer_CELabel10.Caption = "Numeric 4"
CETrainer_CELabel10.Font.Color = 0x0000FF
-- ...
CETrainer_CELabel11.Caption = "Numeric 5"
CETrainer_CELabel11.Font.Color = 0x0000FF
-- ...
CETrainer_CELabel12.Caption = "Numeric 6"
CETrainer_CELabel12.Font.Color = 0x0000FF
-- ...
CETrainer_CELabel13.Caption = "Numeric 7"
CETrainer_CELabel13.Font.Color = 0x0000FF
-- ...
CETrainer_CELabel14.Caption = "Numeric 8"
CETrainer_CELabel14.Font.Color = 0x0000FF
-- ...
CETrainer_CELabel15.Caption = "Numeric 9"
CETrainer_CELabel15.Font.Color = 0x0000FF
-- 9
CETrainer_CELabel9.Caption = "EE 60+"
CETrainer_CELabel9.Font.Color = 0x0000FF
-- Title
CETrainer_CELabel16.Caption = "GTA: SAN_ANDREAS Cheat Menu"
CETrainer_CELabel16.Font.Color = 0x0000FF
-- CheckBox Names et colours
CETrainer_CECheckbox1.Caption = "Cars Invisible"
CETrainer_CECheckbox1.Font.Color = 0x0000FF
-- CheckBox Names et colours
CETrainer_CECheckbox2.Caption = "Cars on Water"
CETrainer_CECheckbox2.Font.Color = 0x0000FF
-- CheckBox Names et colours
CETrainer_CECheckbox3.Caption = "Infinite Ammo"
CETrainer_CECheckbox3.Font.Color = 0x0000FF
