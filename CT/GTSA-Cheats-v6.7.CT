-- -------------------------------------------------------
-- 50 thousand attempts later ...
-- check file -&gt; check line -&gt; check value -&gt; execute
-- -------------------------------------------------------
function No_Fall_DMG(sender)
--does not work when saves as .exe
--local MyTextFile = ".\\pnach_companion_app.ini"
local MyTextFile = "C:\\Games\\PS2\\PCSX2 1.6.0\\pnach_companion_app.ini"
    local fileAttr = io.open(MyTextFile, "r")
    if not fileAttr then
        print("No Initialisation File Found")
        return
    end
    fileAttr:close()

    local fileContent = {}
    for line in io.lines(MyTextFile) do
        table.insert(fileContent, line)
    end

    local lineIndex = nil
    local currentValue = nil
    for i, line in ipairs(fileContent) do
        if line:match("^NoFallDMG=") then
            lineIndex = i
            -- Extract the value only if it's exactly '0' or '1' with optional surrounding whitespace
            local val = line:match("^NoFallDMG=%s*(%S+)%s*$")
            if val == "0" then
                -- Change to 1
                local prefix = line:match("^(NoFallDMG=%s*)")
                local newLine = prefix .. "1"
                fileContent[i] = newLine
                currentValue = "0"
            elseif val == "1" then
                print("Already set to 1.")
                return
            else
                -- Invalid or unexpected value
                --print("Invalid NoFallDMG value: " .. (val or "nil"))
                print("Invalid NoFallDMG line: " .. line)
                return
            end
        end
    end

if not lineIndex then
    print("Line Not Found")
    return
end

if currentValue == "0" then
    local AoB = AOBScan("D4 96 70 00")
    local address = AoB and AoB[0] or nil

    if address then
        -- Check if address starts with '3'
        local skipWriteBytes = false
        if address:sub(1,1) == '3' then
            skipWriteBytes = true
        end

        -- Determine what to add
        local hasOriginal = false
        local hasPlainNew = false
        local maxNewIndex = 0

        for _, line in ipairs(fileContent) do
            if line:match("^Address_Original=") then
                hasOriginal = true
            elseif line:match("^Address_New$") then
                hasPlainNew = true
            elseif line:match("^Address_New(%d+)=.*") then
                local index = tonumber(line:match("^Address_New(%d+)=.*"))
                if index and index &gt; maxNewIndex then
                    maxNewIndex = index
                end
            end
        end

        local nextIndex = maxNewIndex + 1
        local newLine = nil

        if not hasOriginal then
            newLine = "Address_Original=" .. address
        elseif not hasPlainNew and maxNewIndex == 0 then
            newLine = "Address_New=" .. address
        elseif maxNewIndex &gt; 0 then
            newLine = "Address_New" .. nextIndex .. "=" .. address
        end

        -- Build new content with the new address line inserted
        local newFileContent = {}
        for i, line in ipairs(fileContent) do
            table.insert(newFileContent, line)
            if i == lineIndex then
                if newLine then
                    table.insert(newFileContent, newLine)
                end
            end
        end

        -- Save the updated file
        local file = io.open(MyTextFile, "w")
        if not file then
            print("Failed to open file for writing.")
            return
        end
        for _, line in ipairs(newFileContent) do
            file:write(line, "\n")
        end
        file:close()

        -- Conditionally patch bytes in memory
        if AoB and not skipWriteBytes then
            writeBytes(AoB[0], 0xD4, 0x90, 0x90, 0x90)
            print("No Fall Damage set to 1")
            print("Address at: " .. address)
        else
            -- If address starts with '3', just print without patching
            print("Address (skipped patch): " .. address)
        end
    end
end

    sender.Enabled = false
end
