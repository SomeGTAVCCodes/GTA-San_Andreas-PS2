function onPostHotKey() -- Set Cars Invisible on press Numeric 0
if ((checkbox_getState(CETrainer.CECheckBox1)) == 0) then
      CETrainer.CELabel5.Font.Color = green -- 'Cheat Enabled...'
      checkbox_setState(CETrainer.CECheckBox1, 1) -- set checkbox Ticked
      writeByte(0x2088D81B,1)
elseif ((checkbox_getState(CETrainer.CECheckBox1)) == 1) then
      CETrainer.CELabel5.Font.Color = red -- 'Cheat Disabled...'
      checkbox_setState(CETrainer.CECheckBox1, 0) -- set checkbox Not Ticked
      writeByte(0x2088D81B,0)
else
print("fail")
end
end

