--100% STATS unlock - Hydra + Rhino, and other bonues etc
--//20802260 447A0000
function completeunlock(sender)
  writeBytes(0x20802260, 0x00, 0x00, 0x7A, 0x44)
  -- Disable after use
  sender.Enabled = false
end

function MoonSize(sender)
moon=readSmallInteger(0x20666D4C)
moonvalueToAdd=1
if moon ~= 7 then
   writeSmallInteger(0x20666D4C, moon + moonvalueToAdd)
else
writeBytes(0x20666D4C, 0x00, 0x00, 0x00, 0x00)
end
end

-- This is Infinite Ammo using Replenish Clip,
-- as a result: no reload is required and rockets become fast firing.
function TOGGLE_FAST_RELOAD(sender)
--patch=1,EE,20134340,extended,24420001 // Chamber 	|| 2442FFFF --&gt; 24420001
--patch=1,EE,201343A4,extended,24420000 // CLIP		|| 2442FFFF --&gt; 24420000
  if sender.checked then
    writeBytes(0x20134340, 0x01, 0x00, 0x42, 0x24)
    writeBytes(0x201343A4, 0x00, 0x00, 0x42, 0x24)
  else
    writeBytes(0x20134340, 0xFF, 0xFF, 0x42, 0x24)
    writeBytes(0x201343A4, 0xFF, 0xFF, 0x42, 0x24)
  end

end

