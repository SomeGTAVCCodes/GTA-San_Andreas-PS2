        { keys = { "farmtr1", "610" }, value = 610 },
          -- Continue for other mappings, if any.
        { keys = { "utiltr1", "611" }, value = 611 }
        }

    local text = CETrainer.CEEdit1.Text
    local VHID_CHOICE = nil

    for _, group in ipairs(mappings) do
        for _, key in ipairs(group.keys) do
            if text == key then
                VHID_CHOICE = group.value
                break
            end
        end
        if VHID_CHOICE then break end
    end

    if VHID_CHOICE then
        writeSmallInteger(0x2059ED14, VHID_CHOICE)
        -- Optional: reset or update your UI here if needed
        CETrainer.CEEdit1.Text = "_"
    end
end

