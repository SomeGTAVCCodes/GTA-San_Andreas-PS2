-- MAKE TIMER A FUNCTION
WEAPON_SKILLS_timer.OnTimer = function()
  if state == "init2" then
    --print("Skill 1...")
    state = "Pistol_DONE"
    writeBytes(0x20802374, 0x00, 0x00, 0x7A, 0x44) --Pistol Skill
