-- Unlock specific achievement based on game progress
function PS3_Achievements()

  -- True by default
  achievements[1] = true -- "Getting Started" Always true from start up

  local passed2 = readBytes(0x20802524) -- STATS "Number of vehicles exported"
  if passed2 &gt;= 1 then
    achievements[2] = true -- "2 - A Legitimate Business.png"
  end

  local passed3 = readBytes(0x20802494) -- STATS "Total legitimate kills"
  if passed3 &gt;= 100 then
    achievements[3] = true -- "3 - Assassin.png"
  end

  local passed4 = readBytes(0x20802418) -- STATS "Mission attempts"
  if passed4 == 1 then
    achievements[4] = true -- "4 - Assert Yourself Next Time.png"
  end

-- --------------------------------------
-- ---- Chick Magnet ----
-- --------------------------------------
local addressCM = 0x208022C4

--expected value = 447A0000  -- for reference
--cheat = Circle, Triangle, Triangle, Up, Circle, R1, L2, Up, Triangle, L1, L1, L1

-- read 4 bytes from address
local function readFourBytes(addressCM)
  local b1 = readByte(addressCM)
  local b2 = readByte(addressCM + 1)
  local b3 = readByte(addressCM + 2)
  local b4 = readByte(addressCM + 3)
  return b1, b2, b3, b4
end

local b1, b2, b3, b4 = readFourBytes(addressCM)
local result = string.format("%02X %02X %02X %02X", b1, b2, b3, b4)
--print(result)

if result == "00 00 7A 44" then
  max_appeal = true
end

