--[[
 MAX SKILLS NOTES;-
--tested with NO SENDER and it worked (so whast the point in it???)
--todo weapon skills
-- we use driving skill in 2nd place becuase ...
-- a) first skill notification for flying might occur when anothe rmessage big op rsmall is alreayd on screen
... ^^ the address for those popups is unknown
-- b) the driving skill has no pop-up notification,
... so if the flying skill is blocked by an existing message timer, it has time to run becuas drivign skill msg does not exist
Bike skill is the shortest message, then cycling skill - although MAIN.SCM Timers have not been checked
10 seconds should be more than enough, 8 may work, 6, and 7 may conflict IF emulator is on slowdown.
In-Game time, System time, real time and the apps time is not the same
Doing the same for weapons takes 11 x 10seconds +1 ...
... - which as you can imagine is painfully long and no gurantee the messges will not conflcit with other po-ups..
... - and never consistant and emualtor per is based on many variables software and hardware.
--]]

function MAX_SKILLS(sender)
  local t = createTimer()
  local states = {
    {msg="FLYING Skill...", addr=0x2080254C},
    {msg="DRIVING Skill...", addr=0x20802450},
    {msg="BIKE Skill...", addr=0x20802564},
    {msg="CYCLING Skill...", addr=0x20802568},
  }
  local index = 1
  t.Interval = 1000
  t.OnTimer = function()
    if index &gt; #states then
      print("All Vehicle Skills Done!")
      t.Enabled = false; t.destroy()
      print("Timer destroyed!")
      -- Disable when finished
      sender.Enabled = false
      return
    end
    print(states[index].msg)
    writeBytes(states[index].addr, 0xE8, 0x03, 0x00, 0x00)
    if index == 1 then t.Interval=10000 end
    index = index + 1
  end

  -- Disable sender if needed
  sender.Enabled = false
  t.Enabled = true
end

function WEAPON_SKILLS_wtf(sender)
    local skills = {
        {address=0x20802374, name="Pistol"},
        {address=0x20802378, name="Silenced Pistol"},
        {address=0x2080237C, name="Desert Eagle"},
        {address=0x20802380, name="Shotgun"},
        {address=0x20802384, name="Sawn-Off Shotgun"},
        {address=0x20802388, name="Combat Shotgun"},
        {address=0x2080238C, name="Machine Pistol"},
        {address=0x20802390, name="SMG"},
        {address=0x20802394, name="AK-47"},
        {address=0x20802398, name="M4"},
        {address=0x2080239C, name="Rifle"}
    }

    local currentIndex = 1
    local timer = createTimer()

    timer.Interval = 1000
    timer.OnTimer = function()
        if currentIndex &gt; #skills then
            print("All Weapon Skills Activated!")
            timer.Enabled = false
            timer.destroy()
            -- Disable when finished
            sender.Enabled = false
            -- PS3_Achievement when finished
            PS3_Achievements()
            return
        end

        -- Write bytes to activate the skill
        writeBytes(skills[currentIndex].address, 0x00, 0x00, 0x7A, 0x44)
        print("Activated skill: " .. skills[currentIndex].name)

        -- Set interval to 10 seconds after the first activation
        if currentIndex == 1 then
            timer.Interval = 10000
        end

        currentIndex = currentIndex + 1
    end

    -- Disable sender if needed
    sender.Enabled = false
    timer.Enabled = true
end

--[[
function WEAPON_SKILLS_wtf(sender)
local WEAPON_SKILLS_timer = createTimer()
local state = "init2"

--SET TIMER
