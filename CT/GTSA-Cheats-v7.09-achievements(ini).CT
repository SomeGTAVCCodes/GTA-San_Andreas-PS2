-- --------------------------------------
-- ---- All Achievements 20/21 Complete ----
-- --------------------------------------
-- if 100% complete then achievements[19] = true -- "100%"

local achievedCount = 0
for i = 1, 20 do
    if achievements[i] then
        achievedCount = achievedCount + 1
    end
end

if achievedCount == 20 then
    -- 20 (or more) achievements achieved
    --ALL_passed = true
    --print("All 20 achievements")
    achievements[21] = true -- "21 - The_Key_To_San_Andreas.png"
else
    -- LUA handles DO NOTHING :)
end

   --update achivements ini
  updateAchievementsIni()
end

local iniFilePath = "C:\\Games\\PS2\\PCSX2 1.6.0\\pnach_companion_app.ini"

function updateAchievementsIni()
    -- Read the INI file
    local file = io.open(iniFilePath, "r")
    if not file then
        print("Failed to open INI file")
        return
    end

    local lines = {}
    for line in file:lines() do
        table.insert(lines, line)
    end
    file:close()

    -- Process each line
    for i, line in ipairs(lines) do
        -- Match the pattern: "key"=value
        local key, value = line:match('^(".*")=(.*)$')
        if key and value then
            -- If achievement is achieved, set to "complete"
            -- For achievement 1, always set to "complete" if achievements[1] is true
            if achievements[1] and key == '"1 - Getting Started.png"' then
                lines[i] = key .. "=complete"
            -- For other achievements, set to "complete" if achieved
            elseif achievements[i] and key == ('"' .. achievementFilenames[i] .. '"') then
                lines[i] = key .. "=complete"
            -- Otherwise, if value is 'true', change to 'false' (for safety)
            elseif value:lower() == "true" then
                lines[i] = key .. "=false"
            end
        end
    end

    -- Write back to the INI file
    local file2 = io.open(iniFilePath, "w")
    if not file2 then
        print("Failed to open INI file for writing")
        return
    end

    for _, line in ipairs(lines) do
        file2:write(line .. "\n")
    end
    file2:close()
    -- create et open form
    PS3_Achievements_part2()
end

-- Create UI (form) to display achievements
function PS3_Achievements_part2()
  local form = createForm(false)
  local formWidth = (imageSize + spacing) * gridSize + spacing
  local formHeight = (imageSize + spacing) * gridSize + spacing
  form.Width = formWidth
  local formHeight = (imageSize + spacing) * gridSize + spacing
  form.Height = formHeight

  for i, filename in ipairs(achievementFilenames) do
    if achievements[i] then
      local row = math.floor((i - 1) / gridSize)
      local col = (i - 1) % gridSize

      local pic = createImage(form)
      pic.Width = imageSize
      pic.Height = imageSize
      pic.Left = spacing + col * (imageSize + spacing)
      pic.Top = spacing + row * (imageSize + spacing)
      pic.Picture.LoadFromFile(basePath .. filename)
    end
  end

  form.Show()
end

