  elseif state == "M4_DONE" then
    --print("Skill 4...")
    state = "Rifle_DONE"
    writeBytes(0x2080239C, 0x00, 0x00, 0x7A, 0x44) --Rifle Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "CYCLING_DONE" then
    print("All Vehicle Skills Done!")
    MAX_SKILLS_timer.Enabled = false
    MAX_SKILLS_timer.destroy()
    print("Timer destroyed!")
     -- Disable after use --CETrainer_CEButton26.Enabled = false
    --sender.Enabled = false
  end
end
end
