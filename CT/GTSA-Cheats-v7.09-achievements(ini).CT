-- BESLES-52541GTA5 | 42 45 53 4C 45 53 2D 35 32 35 34 31 47 54 41 35
function GameCheck()
AoB_GC = AOBScan("42 45 53 4C 45 53 2D 35 32 35 34 31 47 54 41 35")
  if AoB_GC then
    print("SAN ANDREAS Found")
  else
    print("GAME NOT RECOGNISED")
  end
end

