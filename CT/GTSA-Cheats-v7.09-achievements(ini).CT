    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "Silenced_DONE" then
    --print("Skill 3...")
    state = "Desert_DONE"
    writeBytes(0x2080237C, 0x00, 0x00, 0x7A, 0x44) --Desert Eagle Skil
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "Desert_DONE" then
    --print("Skill 4...")
    state = "Shotgun1_DONE"
    writeBytes(0x20802380, 0x00, 0x00, 0x7A, 0x44) --Shotgun Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "Shotgun1_DONE" then
    --print("Skill 4...")
    state = "Shotgun2_DONE"
    writeBytes(0x20802384, 0x00, 0x00, 0x7A, 0x44) --Shotgun Sawn-Off Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "Shotgun2_DONE" then
    --print("Skill 4...")
    state = "Shotgun3_DONE"
    writeBytes(0x20802388, 0x00, 0x00, 0x7A, 0x44) --Shotgun Combat Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "Shotgun3_DONE" then
    --print("Skill 4...")
    state = "Machine_DONE"
    writeBytes(0x2080238C, 0x00, 0x00, 0x7A, 0x44) --Machine Pistol Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "Machine_DONE" then
    --print("Skill 4...")
    state = "SMG_DONE"
    writeBytes(0x20802390, 0x00, 0x00, 0x7A, 0x44) --SMG Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "SMG_DONE" then
    --print("Skill 4...")
    state = "AK47_DONE"
    writeBytes(0x20802394, 0x00, 0x00, 0x7A, 0x44) --AK-47 Skill
    WEAPON_SKILLS_timer.Interval = 10000

  elseif state == "AK47_DONE" then
    --print("Skill 4...")
