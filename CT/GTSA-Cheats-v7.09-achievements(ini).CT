--[[
function No_Fall_DMG_OLD(sender)
AoB = AOBScan("D4 96 70 00")
  if AoB then
    --print("Dynamic Address Found")
    writeBytes(AoB[0], 0xD4, 0x90, 0x90, 0x90)
    -- Disable after use
    sender.Enabled = false
  else
    -- Disable if fail
    sender.Enabled = false
    --Clean up AOB scan objects
    AoB.destroy()
  end
end
--]]
