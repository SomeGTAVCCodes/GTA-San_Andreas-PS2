-- //Cars Invisible // patch=1,EE,2088D81B,byte,1
function CETrainer_CECheckbox1Change(sender)
    local value = sender.checked and 1 or 0
    writeByte(0x2088D81B, value) -- SAN ANDREAS
    -- Update label color based on checkbox state
    CETrainer.CELabel5.Font.Color = sender.checked and green or red
end

