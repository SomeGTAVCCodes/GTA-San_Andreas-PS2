        { keys = { "farmtr1", "610" }, value = 610 },
          -- Continue for other mappings, if any.
        { keys = { "utiltr1", "611" }, value = 611 }
        }

    local text = CETrainer.CEEdit1.Text
    local VHID_CHOICE = nil

    for _, group in ipairs(mappings) do
        for _, key in ipairs(group.keys) do
            if text == key then
                VHID_CHOICE = group.value
                break
            end
        end
        if VHID_CHOICE then break end
    end

    if VHID_CHOICE then
        writeSmallInteger(0x2059ED14, VHID_CHOICE)
        -- Optional: reset or update your UI here if needed
        CETrainer.CEEdit1.Text = "_"
    end
end

-- -----------------------------------------
-- ---- Timers: VEHICLE ID GET ----
-- -----------------------------------------

-- timer get VH ID from +,-
t1=createTimer(nil)
timer_setInterval(t1,100) --check every 1/100th second if the value has changed
timer_onTimer(t1,GET_VHID)

-- timer get VH ID from users text entry
t2=createTimer(nil)
timer_setInterval(t2,100)
timer_onTimer(t2,VHID_FROM_TEXT_EDIT)

-- -----------------------------------------
-- ---- Hotkeys, Button Inputs: Functions. (Refactored Version 3) ----
-- -----------------------------------------

function toggleCheat(checkbox, label, address)
    local state = checkbox_getState(checkbox)
    local newState = 1 - state -- toggle between 0 and 1
    local color = (newState == 1) and green or red

    checkbox_setState(checkbox, newState)
    label.Font.Color = color
    writeByte(address, newState)
end

function onPostHotKey()
toggleCheat(CETrainer.CECheckBox1, CETrainer.CELabel5, 0x2088D81B)
end

function onPostHotKey2()
    toggleCheat(CETrainer.CECheckBox2, CETrainer.CELabel6, 0x2088D822)
end

function onPostHotKey3()
    toggleCheat(CETrainer.CECheckBox4, CETrainer.CELabel7, 0x2088D830)
end

function onPostHotKey4()
    toggleCheat(CETrainer.CECheckBox5, CETrainer.CELabel8, 0x2088D849)
end

-- -----------------------------------
-- Special Cases (Black, Pink Switch)
-- -----------------------------------
function onPostHotKey5() -- Set Cars black on press Numeric 4
if ((checkbox_getState(CETrainer.CECheckBox7)) == 0) then
      CETrainer.CELabel10.Font.Color = green -- 'Cheat Enabled...'
      checkbox_setState(CETrainer.CECheckBox7, 1) -- set checkbox Ticked
      writeByte(0x2088D821,1) --black on
      writeByte(0x2088D820,0) --pink off
      checkbox_setState(CETrainer.CECheckBox6, 0) -- set checkbox Ticked off pink
elseif ((checkbox_getState(CETrainer.CECheckBox7)) == 1) then
      CETrainer.CELabel10.Font.Color = red -- 'Cheat Disabled...'
      checkbox_setState(CETrainer.CECheckBox7, 0) -- set checkbox Not Ticked
      writeByte(0x2088D821,0)
else
print("fail")
end
end

function onPostHotKey6() -- Set Cars pink on press Numeric 5
if ((checkbox_getState(CETrainer.CECheckBox6)) == 0) then
      CETrainer.CELabel11.Font.Color = green -- 'Cheat Enabled...'
      checkbox_setState(CETrainer.CECheckBox6, 1) -- set checkbox Ticked
      writeByte(0x2088D820,1) --pink on
      writeByte(0x2088D821,0) --black off
      checkbox_setState(CETrainer.CECheckBox7, 0) -- set checkbox Ticked off black
elseif ((checkbox_getState(CETrainer.CECheckBox6)) == 1) then
      CETrainer.CELabel11.Font.Color = red -- 'Cheat Disabled...'
      checkbox_setState(CETrainer.CECheckBox6, 0) -- set checkbox Not Ticked
      writeByte(0x2088D820,0)
else
print("fail")
end
end

function onPostHotKey7()
    toggleCheat(CETrainer.CECheckBox10, CETrainer.CELabel12, 0x2088D80B)
end

function onPostHotKey8()
    toggleCheat(CETrainer.CECheckBox3, CETrainer.CELabel13, 0x2088D848)
end

function onPostHotKey9()
    toggleCheat(CETrainer.CECheckBox8, CETrainer.CELabel14, 0x2088D83D)
end

function onPostHotKey10()
    toggleCheat(CETrainer.CECheckBox9, CETrainer.CELabel15, 0x2088D83E)
end

