//--------------------------
// ---- No Fall Damage ----
//--------------------------
// * This is a "DYNAMIC address", hopefully the hex value (007096D4) is unique
// * AOB Scan with Cheat Engine shows 1 result so added it to cheat companion app.
// * also possible to remove animation (same memory region, still dynamic)
// * "word" instead of Byte, extended still works: https://www.felixcloutier.com/x86/aam
//--------------------------
No Fall Damage Default value to find = 007096D4
AoB = AOBScan("D4 96  70 00")
writeBytes(AoB[0]=0xD4, 0x90, 0x70, 0x00)

//No Fall Damage (1) - TKBS (NOP)	| AAM — ASCII Adjust AX After Multiply
//patch=1,EE,20E70D88,word,909096D4 | 007096D4 --> 909096D4

//No Fall Damage (2) - TKBS (NOP)   | Cleaner hex edit
//patch=1,EE,20E70D88,word,007090D4 | 007096D4 --> 007090D4

//No Fall Damage (3) - TKBS  		| Minimal amount of changes required.
//patch=1,EE,20E70D89,byte,90 		| 96 --> 90 | xchg eax,esi
//--------------------------

//Dynamic Super Punch (includes npcs - might make GYM fights difficult)
