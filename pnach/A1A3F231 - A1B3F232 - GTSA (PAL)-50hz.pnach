patch=1,EE,2088D843,extended,1 				//SET Super Punch ON

//Dynamic Super Jump with Gravity Set, to fix falling from heights damage.
// * The order of the On Off will make a difference.
// * i.e. default jump is fence height and grab. 0, 1 is above fence height, 1,0 is big jump.
// So with 1, 0 - Player can tap square = big jump, then hold square to control gravity descent.
// 				- or press and hold square for normal jump that increases gradually as you hold. Gravity set to throw player in usual jump direction.
patch=1,EE,2088D83C,extended,1 				//SET Super Jump (ON, OFF)
patch=1,EE,E10100FF,extended,00700ACF 		//if value at address = FF (player is pressing SQUARE)
