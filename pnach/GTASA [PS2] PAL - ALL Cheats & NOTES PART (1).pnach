// * Little Endian - hex -
//Set PAL 640x512 --> 640x480

2082A3E8 || array of byte 80 02 00 00 00 02 E0 01
20C70D70 || array of byte 80 02 00 00 00 02 E0 01

2082A3E8 = 640
2082A3EC = 512

reference;-
[640 x 480] = 80 02 00 00 00 02 00 00
[640 x 512] = 80 02 00 00 00 02 E0 01
80 07 00 00 38 04 00 00
80 02 00 00 00 02 00 00
