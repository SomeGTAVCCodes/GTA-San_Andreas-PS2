//--------------------------------------------------------------------
// ---- References; -----
//--------------------------------------------------------------------
	Reference; HEX 	--> VALUES
		3F000000 = 0.5 (float)
		3F400000 = 0.75
		3EBEB852 = 0.375
		3F800000 = 1.0 (float)
		41200000 = 10.0 TOP of screen if using e.g. health bar size
		42C80000 = 100.0 (float)
		42588889 = 54.13333511 (float)

		3c04#### = usually edit the last 4 bytes.
		4###0000 = usually stats related
		0C146818 = "0C" type stuff can be cancelled with 00 or 3C - 00000000 is not a NOP instruction.

		NOP = 90

