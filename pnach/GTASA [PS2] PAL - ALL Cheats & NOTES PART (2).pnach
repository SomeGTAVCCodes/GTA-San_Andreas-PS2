//-----------------------------------------------------------
//---- Dynamic HUD & radar Clean - for cutscenes. ----
//-----------------------------------------------------------
// ** These can be permanently enabled but... may need some tweaks .**
//TODO
//  - A better solution: The cinematic camera mode that kicks in when IDLE temp removes hud, this would be useful because it controls what we are trying to achieve here.
// Notes;-
//		//cutscene flag addresses.
//		//2079802C FFFF0000 || 003D0000 || 003D0001
//		//20797FAC FFFF0000 || 003B0000 || 003B0001|| 003B0002

//Disable Black Bars when subtitles enabled.
//patch=1,EE,206FE66D,extended,00000000

//---- Dynamic HUD ----
//		//-- IF 2079802C = 1  && 20797FAC = 2 || DISABLE HUD & RADAR During Cutscenes
//		patch=1,EE,E1010001,extended,2079802C // cutscene is active
//		patch=1,EE,E1010002,extended,20797FAC // some other cutscene is active
//		patch=1,EE,206FFA64,extended,00000001 // Disable HUD
//		patch=1,EE,E1010001,extended,2079802C // cutscene is active
//		patch=1,EE,E1010002,extended,20797FAC // some other cutscene is active
//		patch=1,EE,206FFA68,extended,00000002 // Disable RADAR

//-- IF 2079802C = 1 (003D0001)  	  || Disable HUD & RADAR During Cutscenes
patch=1,EE,E1010001,extended,0079802C // cutscene is active
patch=1,EE,206FFA64,extended,00000001 // Disable HUD
patch=1,EE,E1010001,extended,0079802C // cutscene is active
patch=1,EE,206FFA68,extended,00000002 // Disable RADAR

//-- IF 2079802C = 0 (003D0000)  	  || Enable HUD & RADAR when Cutscenes END
patch=1,EE,E1010000,extended,0079802C // cutscene is active
patch=1,EE,206FFA64,extended,00000101 // Enable HUD
patch=1,EE,E1010000,extended,0079802C // cutscene is active
patch=1,EE,206FFA68,extended,00000000 // Enable RADAR

