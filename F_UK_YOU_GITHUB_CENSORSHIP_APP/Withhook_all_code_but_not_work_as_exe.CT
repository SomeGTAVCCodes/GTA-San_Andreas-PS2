  </CheatCodes>
  <UserdefinedSymbols/>
  <LuaScript>--[[
TITILE:     GTA:SAN_ANDREAS Cheats App (".exe")
Author:     TKBS
INFO:       A Companion App for ".pnach" cheats.
            Also a basic template for creating cheat apps with CE.
ISSUE:
            Screen == PRIMARY Monitor, not the actual window we hooked
            ... which makes no sense coz we anchor to it.
]]


RequiredCEVersion=7.6
if (getCEVersion==nil) or (getCEVersion()&lt;RequiredCEVersion) then
  messageDialog('Please install Cheat Engine '..RequiredCEVersion, mtError, mbOK)
  closeCE()
end

addresslist=getAddressList()
--CETrainer.SEPERATOR.Visible=false (the line thing from the template menu form)
getAutoAttachList().add("pcsx2.exe")
gPlaySoundOnAction=false
CETrainer.fixDPI() --remove this if you have already taken care of DPI issues yourself
CETrainer.show()
-- -----------------------------------------
-- Hack: Create D3D Hook to show Vehicle ID
-- -----------------------------------------
hooked = false
function starthook()
d3dhook_initializeHook()
-- TEXT stuff -------------
font=createFont() --Default initialized to the mainform font. (black and small)

-- IF 4K font needs to be x2.
value_h = getScreenHeight()
value_w = getScreenWidth()
--print(value_w, "x", value_h) (CAUSES LARGE DELAY)

if value_h &gt; 1080 then
font.size= 50
end

if value_h &lt;= 1080 then
font.size= 25
end

--font properties {size, type, bold, color, etc..} (italic can break fontmap)
--font.size= 25 -- Set font size
font.color=0xFF00FF -- Set font colour
font.Name = "Arial"  -- Set font name
font.Quality = 'fqAntialiased' -- fixes D3D Overlay draws.
font.Position = 'poScreenTop' -- anchor pos
--font.Style = "fsBold"  -- Set the font style to bold
fontmap=d3dhook_createFontmap(font)  --create a fontmap from the defined font. After this font can be destroyed. If you wish different colors and types, create a new fontmap each time
DisplayedTextObject=d3dhook_createTextContainer(fontmap,100,100,'VEHICLE ID')
--The DisplayedTextObject is a TextContainer class. It inherits from the D3DHook_RenderObject, so d3dhook_renderobject_* methods work on this object
--example to change the y position to 300 you'd do
--d3dhook_renderobject_setY(DisplayedTextObject, 255)
--d3dhook_renderobject_setX(DisplayedTextObject, 1570)
-- or
--dx1=1625
--dy1=255

--The textcontainer also has it's own methods, like d3dhook_textcontainer_setText
--d3dhook_textcontainer_setText(DisplayedTextObject, "VEHICLE ID")

-- Toggle update Old -&gt; New VH ID -------------
t2=createTimer(nil)
timer_setInterval(t2,100)
timer_onTimer(t2,TOGGLE_SHOW_VHID)

t3=createTimer(nil)
timer_setInterval(t3,200)
timer_onTimer(t3,TOGGLE_SHOW_VHID2)

-- initialise a 2nd instance of our text, for our toggle update.
VHIDSHOW2 = readSmallInteger(0x2059ED14)

-- Show Vehicle ID D3DHook TEXT (switch 1)
DisplayedTextObject2=d3dhook_createTextContainer(fontmap,100,100,'VH ID NUM')
d3dhook_textcontainer_setText(DisplayedTextObject2, VHIDSHOW2)
--d3dhook_renderobject_setY(DisplayedTextObject2, 255)
--d3dhook_renderobject_setX(DisplayedTextObject2, 1760)
d3dhook_renderobject_setVisible(DisplayedTextObject2, false)

-- Show Vehicle ID D3DHook TEXT (switch 2)
DisplayedTextObject3=d3dhook_createTextContainer(fontmap,100,100,'VH ID NUM')
d3dhook_textcontainer_setText(DisplayedTextObject3, VHIDSHOW2)
--d3dhook_renderobject_setY(DisplayedTextObject3, 255)
--d3dhook_renderobject_setX(DisplayedTextObject3, 1760)
d3dhook_renderobject_setVisible(DisplayedTextObject3, false)

visibleID=true -- NOT IMPLEMENTED
function TOGGLE_SHOW_VHID()
  d3dhook_renderobject_setVisible(DisplayedTextObject2, false) -- hide
  d3dhook_renderobject_setVisible(DisplayedTextObject3, true) -- show
  d3dhook_renderobject_setVisible(DisplayedTextObject, true) -- show
end

function TOGGLE_SHOW_VHID2()
  d3dhook_renderobject_setVisible(DisplayedTextObject3, false) -- hide
  d3dhook_renderobject_setVisible(DisplayedTextObject2, true) -- show
  d3dhook_renderobject_setVisible(DisplayedTextObject, false) -- show
end

if value_h &gt; 1080 then
DisplayedTextObject.x='poScreenRight'
DisplayedTextObject.y=65

DisplayedTextObject2.x='poScreenRight'
value121=DisplayedTextObject2.x + 400
DisplayedTextObject2.x=value121
DisplayedTextObject2.y=65

DisplayedTextObject3.x='poScreenRight'
value111=DisplayedTextObject3.x + 400
DisplayedTextObject3.x=value111
DisplayedTextObject3.y=65
end

if value_h &lt;= 1080 then
DisplayedTextObject.x='poScreenRight'
DisplayedTextObject.y=65

DisplayedTextObject2.x='poScreenRight'
value121=DisplayedTextObject2.x + 200
DisplayedTextObject2.x=value121
DisplayedTextObject2.y=65

DisplayedTextObject3.x='poScreenRight'
value111=DisplayedTextObject3.x + 200
DisplayedTextObject3.x=value111
DisplayedTextObject3.y=65
end
hooked = true
end
