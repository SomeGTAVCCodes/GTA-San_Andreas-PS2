-- Vehicle ID Increment, Decrement (VK_ADD), Decrement (VK_SUBTRACT)
--VK_ADD
--VK_SUBTRACT
function VHID_ADD()

     writeBytes(0x2059ED14,readBytes(0x2059ED14)+1)
if hooked == true then
     d3dhook_renderobject_setVisible(DisplayedTextObject2, true)
     d3dhook_renderobject_setVisible(DisplayedTextObject3, false)
end
end

function VHID_SUBTRACT()
     writeBytes(0x2059ED14,readBytes(0x2059ED14)-1)
     if hooked == true then
     d3dhook_renderobject_setVisible(DisplayedTextObject2, false)
     d3dhook_renderobject_setVisible(DisplayedTextObject3, true)
end
end
