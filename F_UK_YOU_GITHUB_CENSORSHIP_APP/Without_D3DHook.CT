function CETrainer_CECheckbox3Change(sender)
  if sender.checked then
    writeByte(0x2088D848,1)
    CETrainer.CELabel13.Font.Color = green
  else
    writeByte(0x2088D848,0)
    CETrainer.CELabel13.Font.Color = red
  end
end

