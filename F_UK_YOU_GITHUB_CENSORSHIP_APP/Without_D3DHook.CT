-- -----------------------------------------
-- ---- Spawn Vehicle (".pnach support") ----
-- ----------------------------------------

function ENABLE_VH_SPAWN(sender)
  writeBytes(0x2059D4A0, 0x18, 0x1B, 0x02, 0x3C) -- 3C021B18
  writeBytes(0x2059D4B4, 0x2B, 0x4F, 0x42, 0x34) -- 34424F2B

end

function DISABLE_VH_SPAWN(sender)
  writeBytes(0x2059D4B4, 0x00, 0x00, 0x00, 0x00) -- 00000000
  writeBytes(0x2059D4A0, 0x94, 0x58, 0x13, 0x0C) -- 0C135894

end


-- -----------------------------------------
-- ---- VEHICLE ID GET, DISPLAY &amp; UPDATE ----
-- -----------------------------------------
function GET_VHID(sender)
  -- Read a 16-bit integer from address 0x123456
  VHIDSHOW2 = readSmallInteger(0x2059ED14)
  -- Set Label to Show Vehicle ID
  control_setCaption(CETrainer_CELabel1, VHIDSHOW2)

  -- print("Vehicle ID:", value)
end

-- timer get VH ID from +,-
t1=createTimer(nil)
timer_setInterval(t1,100) --check every 1/100th second if the value has changed
timer_onTimer(t1,GET_VHID)

-- timer get VH ID from users text entry
t2=createTimer(nil)
timer_setInterval(t2,100)
timer_onTimer(t2,VHID_FROM_TEXT_EDIT)

-- -----------------------------------------
-- ---- Patch PAL 50, 60hz ----
-- -----------------------------------------
-- PAL 50hz
function PAL_50hz(sender)
  writeBytes(0x20547BC4, 0x01, 0x00, 0x02, 0x24)
  CETrainer.CELabel3.Font.Color = 0x00FF00 -- + 5000000 -- Green (B,G,R)
  CETrainer.CELabel4.Font.Color = 0x0000FF -- + 1100000 -- Red  (B,G,R)
end

-- PAL 60hz
function PAL_60hz(sender)
  writeBytes(0x20547BC4, 0x02, 0x00, 0x12, 0x24)
  CETrainer.CELabel4.Font.Color = 0x00FF00 -- + 5000000 -- Green  (B,G,R)
  CETrainer.CELabel3.Font.Color = 0x0000FF -- + 5500000 -- Red  (B,G,R)
end

-- PAL Emotion Engine 30 -&gt; 60+ || 24040002 -&gt; 24040001
function EENGINE_60()
local str = readByte(0x2039B62C) -- Example
  if str == 01 then
    writeBytes(0x2039B62C, 0x02, 0x00, 0x04, 0x24)
    CETrainer_CELabel9.Caption = "EE 30" -- red, green
    CETrainer_CELabel9.Font.Color = 0x0000FF
  end
  if str == 02 then
    writeBytes(0x2039B62C, 0x01, 0x00, 0x04, 0x24)
    CETrainer_CELabel9.Caption = "EE 60+" -- red, green
    CETrainer_CELabel9.Font.Color = 0x00FF00
  end
end

--[[
-- VICE CITY NOTES
-- Infinite Health
Example: Write Bytes
* Bytes are represented as Decimel
* CE Display Type "Byte Decimel"
* So 200 Health is max health, which is "43480000" (Hex) || 00,00,72,67 (Dec)
* Address = 20B50FF8: || Code = writeBytes(0x20B50FF8,00,00,72,67)
--        writeBytes(0x20B50FF8,00,00,72,67)
-- Rocket Launcher With Sniper Zoom
hex = 0C0944F8
writeBytes(0x2025854C,F8 44 09 0C)
]]

