  <UserdefinedSymbols/>
  <LuaScript>--[[
TITILE:     GTA:SAN_ANDREAS Cheats App (".exe")
Author:     TKBS
INFO:       A Companion App for ".pnach" cheats.
            Also a basic template for creating cheat apps with CE.
ISSUE:
            Screen == PRIMARY Monitor, not the actual window we hooked
            ... which makes no sense coz we anchor to it.
]]

-- -----------------------------------------
-- Define Colours as names (B,G,R)
-- -----------------------------------------
red="0x000000FF"
green="0x0000FF00"
black="0x00999999"
blue="0x00FF0000"
pink="0x0cc00FF"
green2="0x0099FF99"
pink2="0x00FF00FF"

-- -----------------------------------------
-- ---- Hotkeys, Button Inputs: Functions. ----
-- -----------------------------------------
chg = true
function onPostHotKey() -- Set Cars Invisible on press Numeric 0
    if chg then
      chg = false
      --label1.Caption = 'Cheat Enabled...'
      --label1.Font.Color = green
      CETrainer.CELabel5.Font.Color = green
      writeByte(0x2088D81B,1)
    else
      chg = true
      --label1.Caption = 'Cheat Disabled...'
      --label1.Font.Color = red
      CETrainer.CELabel5.Font.Color = red
      writeByte(0x2088D81B,0)
    end
end

chg2 = true
function onPostHotKey2() -- Set Cars on Water on press Numeric 1
   if chg2 then
       chg2 = false
       CETrainer.CELabel6.Font.Color = green
       writeByte(0x2088D822,1)
    else
       chg2 = true
       CETrainer.CELabel6.Font.Color = red
       writeByte(0x2088D822,0)
    end
end

chg3 = true
