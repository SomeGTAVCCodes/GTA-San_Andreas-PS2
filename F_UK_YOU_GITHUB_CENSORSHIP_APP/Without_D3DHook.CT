-- Vehicle ID Increment, Decrement (VK_ADD), Decrement (VK_SUBTRACT)
--VK_ADD
--VK_SUBTRACT
function VHID_ADD()
     local VHID = readSmallInteger(0x2059ED14) -- Read a 16-bit integer from address 0x123456
     writeBytes(0x2059ED14,readBytes(0x2059ED14)+1)

end

function VHID_SUBTRACT()
     local VHID = readSmallInteger(0x2059ED14)
     writeBytes(0x2059ED14,readBytes(0x2059ED14)-1)

end

